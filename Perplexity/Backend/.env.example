# MongoDB connection string (read in config/database.js)
MONGO_URI=

# Secret used to sign login + email-verification tokens
JWT_SECRET=

# Public URL of the frontend (used for CORS and the links inside emails).
# Local: http://localhost:5173   Deployed: https://your-frontend-domain
FRONTEND_URL=http://localhost:5173

# Set to "production" on the deployed server (enables secure cross-site cookies)
NODE_ENV=development

# Gemini (services/ai.service.js)
GOOGLE_API_KEY=

# How many of the user's other recent chats the AI remembers (default 4, 0 turns memory off)
MEMORY_CHAT_COUNT=4

# Tavily web search (services/internet.service.js) - get a key at https://tavily.com
TAVILY_API_KEY=

# Gmail OAuth2 for verification emails (services/mail.service.js)
GOOGLE_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
REFRESH_TOKEN_SECRET=
